    scriptsTabBtn.BackgroundColor3 = (not isHome) and Color3.fromRGB(45, 45, 65) or Color3.fromRGB(28, 28, 38)
    scriptsTabBtn.TextColor3 = (not isHome) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 170)
end

