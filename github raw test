local function addButton(name, url)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 34)
    row.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    row.BorderSizePixel = 0
    row.ZIndex = 8
    row.Parent = list
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, -86, 1, 0)
    nameLbl.Position = UDim2.fromOffset(10, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = name
    nameLbl.TextColor3 = Color3.fromRGB(230, 230, 250)
    nameLbl.Font = Enum.Font.GothamMedium
    nameLbl.TextSize = 11
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.ZIndex = 9
    nameLbl.Parent = row

    local execBtn = Instance.new("TextButton")
    execBtn.Size = UDim2.fromOffset(68, 24)
    execBtn.Position = UDim2.new(1, -74, 0.5, -12)
    execBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    execBtn.BorderSizePixel = 0
    execBtn.Text = "Execute"
    execBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    execBtn.Font = Enum.Font.GothamBold
    execBtn.TextSize = 11
    execBtn.ZIndex = 9
    execBtn.Parent = row
    Instance.new("UICorner", execBtn).CornerRadius = UDim.new(0, 5)

    table.insert(buttonList, {Frame = row, Name = name:lower()})

    execBtn.Activated:Connect(function()
        execBtn.Text = "⏳..."
        task.spawn(function()
            local success, err = pcall(function()
                local source = game:HttpGet(url)
                assert(type(source) == "string" and #source > 0, "Empty script")
                local fn = loadstring(source)
                assert(fn, "Compilation failed")
                fn()
            end)

            execBtn.Text = success and "✅" or "❌"
            task.wait(1.5)
            execBtn.Text = "Execute"

            if not success then
                warn("[021 HUB] " .. name .. ": " .. tostring(err))
            end
        end)
    end)
end

