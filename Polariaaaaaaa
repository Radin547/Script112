local LocalPlayer = Players.LocalPlayer
local rq = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent
local KillDistance = 17
local KilledAlready = {}
local function KillPlayer(player)
if not KilledAlready[player] then
KilledAlready[player] = true
rq:InvokeServer(";kill " .. player.Name)
end
end
local function CheckDistance()
local myChar = LocalPlayer.Character
if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
local dist = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
if dist <= KillDistance then
KillPlayer(player)
end
else
KilledAlready[player] = nil 
end
end
end
RunService.RenderStepped:Connect(CheckDistance)
end)

