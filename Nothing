local function switchTab(activeBtn, activePage)
    homePage.Visible = (activePage == homePage)
    scriptsPage.Visible = (activePage == scriptsPage)

    homeTabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    homeTabBtn.TextColor3 = Color3.fromRGB(150, 150, 170)
    scriptsTabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    scriptsTabBtn.TextColor3 = Color3.fromRGB(150, 150, 170)

    activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

homeTabBtn.Activated:Connect(function() switchTab(homeTabBtn, homePage) end)
scriptsTabBtn.Activated:Connect(function() switchTab(scriptsTabBtn, scriptsPage) end)

