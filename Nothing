local buttonList = {}

local function updateCanvas()
    list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
end

local function addButton(name, url)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 36)
    button.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    button.TextColor3 = Color3.fromRGB(230, 230, 250)
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 13
    button.Text = name
    button.Parent = list
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    table.insert(buttonList, {Btn = button, Name = name:lower()})

    button.Activated:Connect(function()
        button.Text = "⏳ در حال اجرا..."
        task.spawn(function()
            local success, err = pcall(function()
                local source = game:HttpGet(url)
                assert(type(source) == "string" and #source > 0, "Empty script")
                local fn = loadstring(source)
                assert(fn, "Compilation failed")
                fn()
            end)

            button.Text = success and "✅ اجرا شد!" or "❌ خطا!"
            task.wait(1.5)
            button.Text = name

            if not success then
                warn("[021 HUB] " .. name .. ": " .. tostring(err))
            end
        end)
    end)
end

for _, data in ipairs(scripts) do
    addButton(data[1], data[2])
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
updateCanvas()

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = searchBox.Text:lower()
    for _, item in ipairs(buttonList) do
        if query == "" or item.Name:find(query) then
            item.Btn.Visible = true
        else
            item.Btn.Visible = false
        end
    end
    updateCanvas()
end)

