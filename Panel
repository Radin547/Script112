local function addButton(name, url)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -8, 0, 36)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Text = name
    button.Parent = list
    Instance.new("UICorner", button)

    button.Activated:Connect(function()
        button.Text = "Loading..."
task.spawn(function()
            local success, err = pcall(function()
                local source = game:HttpGet(url)
                assert(type(source) == "string" and #source > 0, "Empty script")
                local fn = loadstring(source)
                assert(fn, "Compilation failed")
                fn()
            end)

            button.Text = name

            if not success then
                warn("[021 HUB] " .. name .. ": " .. tostring(err))
            end
        end)
    end)
end

