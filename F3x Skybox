local cachedEndpoint
local statusLabel

local function status(text)
	if statusLabel then statusLabel.Text = text end
end

local function scan(root)
	if not root then return nil end
	for _, o in ipairs(root:GetDescendants()) do
		if o.Name == "SyncAPI" then
			local ep = o:FindFirstChild("ServerEndpoint")
			if ep then return ep end
		end
	end
end

local function findEndpoint()
	if cachedEndpoint and cachedEndpoint.Parent then return cachedEndpoint end
	cachedEndpoint = scan(player) or scan(player.Character) or scan(RS)
	if not cachedEndpoint then -- fork fallback: any RemoteFunction called ServerEndpoint
		for _, root in ipairs({ player, player.Character, RS }) do
			if root then
				for _, o in ipairs(root:GetDescendants()) do
					if o:IsA("RemoteFunction") and o.Name == "ServerEndpoint" then
						cachedEndpoint = o
						break
					end
				end
			end
			if cachedEndpoint then break end
		end
	end
	return cachedEndpoint
end

local function call(...)
	local ep = findEndpoint()
	if not ep then
		status("Equip F3X first")
		return false
	end
	local args = table.pack(...)
	local tries = S.strict and 3 or 1
	local ok, res
	for _ = 1, tries do
		ok, res = pcall(function() return ep:InvokeServer(table.unpack(args, 1, args.n)) end)
		if ok then break end
		task.wait(0.1)
	end
	if not ok then warn("[Skybox] " .. tostring(res)) end
	if S.strict then task.wait(0.05) end
	return ok, res
end

local function syncMesh(part, props)
	if S.strict then -- strict: one property per request
		for k, v in pairs(props) do
			call("SyncMesh", { { Part = part, [k] = v } })
			task.wait(0.08)
		end
	else
		local e = { Part = part }
		for k, v in pairs(props) do e[k] = v end
		call("SyncMesh", { e })
	end
end

local function assetUrl(id)
	id = tostring(id or ""):gsub("%s", "")
	if id == "" then return nil end
	if id:match("^%d+$") then return "rbxassetid://" .. id end
	return id
end

local texCache = {}

local function httpGet(url)
	local req = env.request or env.http_request or (env.syn and env.syn.request) or (env.http and env.http.request)
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and res and res.StatusCode == 200 then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" then return body end
end

local function resolveTexture(text)
	text = tostring(text or ""):gsub("%s", "")
	if text == "" then return nil end
	local num = text:match("^%d+$") or text:match("rbxassetid://(%d+)") or text:match("[?&]id=(%d+)")
	if not num then return text end
	if texCache[num] then return "rbxassetid://" .. texCache[num] end

	status("Resolving " .. num .. "...")
	local img

	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. num) end)
	if ok and type(objs) == "table" then
		for _, o in ipairs(objs) do
			local d = ((o:IsA("Decal") or o:IsA("Texture")) and o)
				or o:FindFirstChildWhichIsA("Decal", true)
				or o:FindFirstChildWhichIsA("Texture", true)
			if d then
				local t = tostring(d.Texture)
				img = t:match("id=(%d+)") or t:match("rbxassetid://(%d+)")
			end
			o:Destroy()
			if img then break end
		end
	end

	if not img then
		local body = httpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. num)
		if body then
			if body:sub(1, 30):find("<roblox") then
				img = body:match("asset/%?id=(%d+)") or body:match("rbxassetid://(%d+)")
			else
				img = num -- raw image data, so it already is an image id
			end
		end
	end

	if img then
		texCache[num] = img
		texCache[img] = img
		status(img == num and "Image id ok" or ("Decal " .. num .. " -> image " .. img))
		return "rbxassetid://" .. img
	end
	status("Can't resolve decal here, use an image id")
	return "rbxassetid://" .. num
end

local function hasSky()
	return S.part ~= nil and S.part.Parent ~= nil
end

local function createSky()
	if S.busy then return end
	local url = assetUrl(S.texture)
	if not url then status("Paste a texture id first") return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then status("No character") return end
	S.busy = true

	local cf = root.CFrame + Vector3.new(0, 6, 0)
	local ok, part = call("CreatePart", "Normal", cf, workspace)
	if not (ok and typeof(part) == "Instance") then
		task.wait(0.2)
		part = nil
		for _, p in ipairs(workspace:GetChildren()) do
			if p:IsA("BasePart") and (p.Position - cf.Position).Magnitude < 1 then part = p break end
		end
	end
	if not part then
		status("Create failed (F3X equipped?)")
		S.busy = false
		return
	end


	call("SetName", { part }, "Sky")
	call("CreateMeshes", { { Part = part } })
	task.wait(0.1)
	local okM = call("SyncMesh", { { Part = part, MeshId = MESH_ID } })
	local okT = call("SyncMesh", { { Part = part, TextureId = url } })
	call("SyncMesh", { { Part = part, Scale = Vector3.new(S.scale, S.scale, S.scale) } })
	call("SyncAnchor", { { Part = part, Anchored = true } })
	call("SyncCollision", { { Part = part, CanCollide = false } }) -- no collisions
	if S.lock then call("SetLocked", { part }, true) end
	if not (okM and okT) then status("Mesh/texture request failed (see output)") end

	S.part = part
	S.pos = part.Position
	S.rot = Vector3.new(0, 0, 0)
	sent = { TextureId = url, Scale = Vector3.new(S.scale, S.scale, S.scale), VertexColor = Vector3.new(1, 1, 1), pos = S.pos }
	S.busy = false
	status("Skybox set")
end

local function deleteSky()
	if not hasSky() then S.part = nil status("No skybox") return end
	local part = S.part
	S.part = nil
	S.anim.on = false
	call("SetLocked", { part }, false)
	call("Remove", { part })
	if part.Parent then call("Remove", { part }) end
	status(part.Parent and "Delete may have failed" or "Skybox deleted")
end


