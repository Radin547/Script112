local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function box(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or BLACK
	props.BorderColor3 = RED
	props.BorderSizePixel = 1
	return new("Frame", props, parent)
end

local function label(parent, text, pos, size, align)
	return new("TextLabel", {
		Text = text, Position = pos, Size = size, BackgroundTransparency = 1,
		TextColor3 = WHITE, TextScaled = true, Font = FONT,
		TextXAlignment = align or Enum.TextXAlignment.Left,
	}, parent)
end

local function button(parent, text, pos, size, cb)
	local b = new("TextButton", {
		Text = text, Position = pos, Size = size, BackgroundColor3 = BLACK,
		BorderColor3 = RED, BorderSizePixel = 1, TextColor3 = WHITE,
		TextScaled = true, Font = FONT, AutoButtonColor = false,
