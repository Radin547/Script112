local function RunHDCommand(cmd)
	local success, RequestCommand = pcall(function()
		return ReplicatedStorage:WaitForChild("HDAdminHDClient", 2).Signals.RequestCommandSilent
	end)
	
	if success and RequestCommand then
		RequestCommand:InvokeServer(cmd)
	else
		local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
			chatEvents.SayMessageRequest:FireServer(cmd, "All")
		end
	end
end

